---
layout: null
sitemap: false
---
{%- comment -%}
  The search index, built at compile time. Titles, standfirsts, categories and
  tags only — never article bodies, which would balloon the file for very
  little gain on a site this size (§19).
{%- endcomment -%}
[
{%- for post in site.posts -%}
{%- assign cat = site.data.categories | where: 'key', post.categories.first | first -%}
{
"t": {{ post.title | jsonify }},
"u": {{ post.url | relative_url | jsonify }},
"d": {{ post.excerpt | default: post.description | strip_html | strip | truncate: 140 | jsonify }},
"c": {{ cat.label | default: '' | jsonify }},
"g": {{ post.tags | join: ' ' | jsonify }}
}{% unless forloop.last %},{% endunless %}
{%- endfor -%}
]
